+struct H264Context;
+struct H264SliceContext;
+
+/*
+ * FFedit for H.264 (CAVLC, progressive frames only).
+ *
+ * The decoder parses each slice NAL from its RBSP (emulation
+ * prevention bytes already stripped).  Instead of mirroring every
+ * bit read into a PutBitContext (the MPEG-4 approach), we only note
+ * where each mvd se(v) code sits and what it should become:
+ *
+ *   RBSP:  | slice header | ... | mvd | ... | mvd | ... | stop bit |
+ *                                 ^pos,len       ^pos,len
+ *
+ * After the slice is decoded the NAL is rebuilt: bits between the
+ * recorded ranges are copied verbatim, the ranges are re-encoded as
+ * se(v), the stop bit and alignment are regenerated, and emulation
+ * prevention bytes are re-inserted.  Unedited NALs are copied raw.
+ */
+
+/* one edited mvd: bit offset (from the NAL header byte) and length
+ * of the original se(v) code, and its replacement value. */
+typedef struct FFEditH264MvdEdit {
+    int pos;
+    int len;
+    int val;
+} FFEditH264MvdEdit;
+
+/* per-slice state (lives in H264SliceContext) */
+typedef struct FFEditH264SliceContext {
+    ffe_mv_mb_ctx mv;
+    ffe_mv_mb_ctx mv_delta;
+
+    FFEditH264MvdEdit *edits;
+    int nb_edits;
+    unsigned edits_alloc;
+} FFEditH264SliceContext;
+
+/* per-decoder state (lives in H264Context) */
+typedef struct FFEditH264Context {
+    /* import: JSON side data handed over by the packet */
+    void *jctx;
+    void *ffedit_sd[32]; // should be at least [FFEDIT_FEAT_LAST]
+
+    /* export: set between frame start and field end */
+    int frame_active;
+
+    /* apply: the packet being rebuilt */
+    const uint8_t *in_buf;
+    size_t in_size;
+    size_t in_pos;      /* input bytes consumed so far */
+    uint8_t *out;
+    size_t out_size;
+    unsigned out_alloc;
+    int out_active;
+    int out_failed;
+} FFEditH264Context;
+
+int  ffe_h264_wants_mv(const AVCodecContext *avctx);
+
+void ffe_h264_packet_start(struct H264Context *h, const AVPacket *avpkt);
+void ffe_h264_packet_end(struct H264Context *h, const AVPacket *avpkt);
+void ffe_h264_nal_done(struct H264Context *h, const H2645NAL *nal);
+
+void ffe_h264_slice_start(struct H264SliceContext *sl);
+void ffe_h264_check_slice(const struct H264Context *h,
+                          const struct H264SliceContext *sl);
+
+void ffe_h264_frame_start(struct H264Context *h);
+void ffe_h264_frame_end(struct H264Context *h);
+
+void ffe_h264_mb_start(struct H264SliceContext *sl);
+int  ffe_h264_mvd(const struct H264Context *h,
+                  struct H264SliceContext *sl,
+                  int list,
+                  int blockn,
+                  int x_or_y,
+                  int pred);
+
+void ffe_h264_uninit(struct H264Context *h);
+
+#endif /* AVCODEC_FFEDIT_H264_H */
