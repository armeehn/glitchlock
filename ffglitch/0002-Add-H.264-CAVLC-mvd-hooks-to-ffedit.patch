+/* ffedit: every non-empty packet yields one output packet, rebuilt
+ * NAL by NAL in decode_nal_units() */
+static int h264_decode_frame(AVCodecContext *avctx, AVFrame *pict,
+                             int *got_frame, AVPacket *avpkt)
+{
+    H264Context *h = avctx->priv_data;
+    int ret;
+
+    if (avpkt->size == 0)
+        return h264_decode_frame_internal(avctx, pict, got_frame, avpkt);
+
+    ffe_h264_packet_start(h, avpkt);
+    ret = h264_decode_frame_internal(avctx, pict, got_frame, avpkt);
+    ffe_h264_packet_end(h, avpkt);
+
+    return ret;
+}
