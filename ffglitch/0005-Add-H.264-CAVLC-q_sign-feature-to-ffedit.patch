-/* rebuild one slice NAL with the recorded mvd edits applied.
+/* n zeros then a one */
+static void put_unary(PutBitContext *pb, int n)
+{
+    put_bits(pb, n + 1, 1);
+}
+
+/* write one CAVLC level (9.2.2.1) the way the decoder reads it in
+ * decode_residual(): levelCode is 2|level|-2 for positive, 2|level|-1
+ * for negative, minus 2 for the first level after fewer than three
+ * trailing ones. The parity carries the sign, so flipping it never
+ * crosses a prefix threshold except the bare unary case. */
+static void put_level(PutBitContext *pb, int level, int suffix_length, int first)
+{
+    int level_code = level > 0 ? 2 * level - 2 : -2 * level - 1;
+    int base;
+    int v;
+    int prefix;
+
+    if ( first )
+        level_code -= 2;
+
+    if ( suffix_length == 0 )
+    {
+        if ( level_code < LEVEL_PREFIX_SHORT )
+        {
+            put_unary(pb, level_code);
+            return;
+        }
+        if ( level_code < LEVEL_PREFIX_SHORT + (1 << LEVEL_SUFFIX_14) )
+        {
+            put_unary(pb, LEVEL_PREFIX_SHORT);
+            put_bits(pb, LEVEL_SUFFIX_14, level_code - LEVEL_PREFIX_SHORT);
+            return;
+        }
+        base = LEVEL_PREFIX_SHORT + (1 << LEVEL_SUFFIX_14);
+    }
+    else
+    {
+        if ( level_code < (LEVEL_PREFIX_ESCAPE << suffix_length) )
+        {
+            put_unary(pb, level_code >> suffix_length);
+            put_bits(pb, suffix_length, level_code & ((1 << suffix_length) - 1));
+            return;
+        }
+        base = LEVEL_PREFIX_ESCAPE << suffix_length;
+    }
+
+    v = level_code - base;
+    if ( v < LEVEL_ESCAPE_RANGE )
+    {
+        put_unary(pb, LEVEL_PREFIX_ESCAPE);
+        put_bits(pb, LEVEL_SUFFIX_ESCAPE, v);
+        return;
+    }
+
+    /* prefix p >= 16 covers v + 4096 in [2^(p-3), 2^(p-2)) */
+    prefix = av_log2(v + LEVEL_ESCAPE_RANGE) + 3;
+    put_unary(pb, prefix);
+    put_bits(pb, prefix - 3, v + LEVEL_ESCAPE_RANGE - (1 << (prefix - 3)));
+}
+
+static void put_edit(PutBitContext *pb, const FFEditH264Edit *e)
+{
+    switch ( e->kind )
+    {
+    case FFE_H264_EDIT_BITS:
+        put_bits(pb, e->nbits, e->val);
+        break;
+    case FFE_H264_EDIT_LEVEL:
+        put_level(pb, e->val, e->suffix_length, e->first);
+        break;
+    default:
+        set_se_golomb(pb, e->val);
+        break;
+    }
+}
