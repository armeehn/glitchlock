+/*-------------------------------------------------------------------*/
+/* edit log                                                          */
+/*-------------------------------------------------------------------*/
+static FFEditH264Edit *record_edit(FFEditH264SliceContext *fsl, int pos, int len, int kind, int val)
+{
+    size_t need = (fsl->nb_edits + 1) * sizeof(FFEditH264Edit);
+    void *tmp = av_fast_realloc(fsl->edits, &fsl->edits_alloc, need);
+    FFEditH264Edit *e;
+
+    if ( tmp == NULL )
+        return NULL;
+    fsl->edits = tmp;
+
+    e = &fsl->edits[fsl->nb_edits++];
+    memset(e, 0, sizeof(*e));
+    e->pos = pos;
+    e->len = len;
+    e->kind = kind;
+    e->val = val;
+
+    return e;
+}
+
+/*-------------------------------------------------------------------*/
+/* q_sign: residual coefficient signs                                */
+/*-------------------------------------------------------------------*/
+
+/* the frame payload is { "mb": [ row ][ col ] -> null | [0,1,...] } */
+typedef struct {
+    json_t *mb;
+} sign_ctx;
+
+static void sign_export_init(json_ctx_t *jctx, AVFrame *f, int mb_width, int mb_height)
+{
+    json_t *jframe = json_object_new(jctx);
+    sign_ctx *ctx = json_allocator_get0(jctx, sizeof(sign_ctx));
+
+    json_object_userdata_set(jframe, ctx);
+    ctx->mb = ffe_jblock_new(jctx, mb_width, mb_height, JSON_PFLAGS_NO_LF);
+    json_object_add(jframe, "mb", ctx->mb);
+
+    f->ffedit_sd[FFEDIT_FEAT_Q_SIGN] = jframe;
+}
+
+static void sign_import_init(json_ctx_t *jctx, AVFrame *f)
+{
+    json_t *jframe = f->ffedit_sd[FFEDIT_FEAT_Q_SIGN];
+    sign_ctx *ctx = json_allocator_get0(jctx, sizeof(sign_ctx));
+
+    json_object_userdata_set(jframe, ctx);
+    ctx->mb = json_object_get(jframe, "mb");
+}
+
+/* write the pending macroblock's signs as one array of ints */
+static void sign_flush_mb(H264Context *h, H264SliceContext *sl)
+{
+    FFEditH264SliceContext *fsl = &sl->ffe;
+    AVCodecContext *avctx = h->avctx;
+    int nb = fsl->nb_signs;
+
+    fsl->nb_signs = 0;
+    fsl->jsign_mb = NULL;
+    fsl->jsign_mb_valid = 0;
+
+    if ( nb == 0 || (avctx->ffedit_export & FEAT_MASK_SIGN) == 0 || h->cur_pic_ptr == NULL )
+        return;
+
+    {
+        AVFrame *f = h->cur_pic_ptr->f;
+        json_t *jframe = f->ffedit_sd[FFEDIT_FEAT_Q_SIGN];
+        sign_ctx *ctx;
+        json_t *jarr;
+
+        if ( jframe == NULL )
+            return;
+        ctx = json_object_userdata_get(jframe);
+        jarr = json_array_of_ints_new(f->jctx, nb);
+        json_set_pflags(jarr, JSON_PFLAGS_NO_LF);
+        for ( int i = 0; i < nb; i++ )
+            jarr->array_of_ints[i] = fsl->signs[i];
+        ffe_jblock_set(ctx->mb, fsl->sign_mb_y, fsl->sign_mb_x, jarr);
+    }
+}
+
+/* imported sign for coefficient idx of the current macroblock, or
+ * fallback when the JSON has no value there */
+static int sign_import_get(FFEditH264SliceContext *fsl, AVFrame *f, int idx, int fallback)
+{
+    json_t *jmb;
+
+    if ( !fsl->jsign_mb_valid )
+    {
+        json_t *jframe = f->ffedit_sd[FFEDIT_FEAT_Q_SIGN];
+        sign_ctx *ctx = jframe ? json_object_userdata_get(jframe) : NULL;
+        json_t *jrow;
+
+        fsl->jsign_mb_valid = 1;
+        fsl->jsign_mb = NULL;
+        if ( ctx == NULL || ctx->mb == NULL
+          || JSON_TYPE(ctx->mb->flags) != JSON_TYPE_ARRAY
+          || json_array_length(ctx->mb) <= fsl->sign_mb_y )
+            return fallback;
+        jrow = json_array_get(ctx->mb, fsl->sign_mb_y);
+        if ( jrow == NULL || JSON_TYPE(jrow->flags) != JSON_TYPE_ARRAY
+          || json_array_length(jrow) <= fsl->sign_mb_x )
+            return fallback;
+        fsl->jsign_mb = json_array_get(jrow, fsl->sign_mb_x);
+    }
+
+    jmb = fsl->jsign_mb;
+    if ( jmb == NULL || json_array_length(jmb) <= idx )
+        return fallback;
+
+    if ( JSON_TYPE(jmb->flags) == JSON_TYPE_ARRAY_OF_INTS )
+        return jmb->array_of_ints[idx] != 0;
+
+    if ( JSON_TYPE(jmb->flags) == JSON_TYPE_ARRAY )
+    {
+        json_t *jval = json_array_get(jmb, idx);
+        if ( jval != NULL && JSON_TYPE(jval->flags) == JSON_TYPE_NUMBER && !is_json_null(jval) )
+            return json_int_val(jval) != 0;
+    }
+
+    return fallback;
+}
+
+/* called once per residual block after its levels are read.
+ * level[0..total_coeff) in bitstream order; pos[i] is the bit offset
+ * of level i's code (pos[0..trailing_ones) are the one-bit sign
+ * flags, pos[total_coeff] the end), suffix_length[i] the
+ * suffixLength it was read with. */
+void ffe_h264_levels(
+        const H264Context *h,
+        H264SliceContext *sl,
+        int *level,
+        int total_coeff,
+        int trailing_ones,
+        const int *pos,
+        const int *suffix_length)
+{
+    const AVCodecContext *avctx = h->avctx;
+    FFEditH264SliceContext *fsl = &sl->ffe;
+    AVFrame *f = h->cur_pic_ptr ? h->cur_pic_ptr->f : NULL;
+    int importing = (avctx->ffedit_import & FEAT_MASK_SIGN) != 0 && f != NULL;
+    int exporting = (avctx->ffedit_export & FEAT_MASK_SIGN) != 0;
+
+    if ( !importing && !exporting )
+        return;
+
+    if ( fsl->nb_signs + total_coeff > FFE_H264_MAX_SIGNS )
+    {
+        if ( !fsl->sign_overflow )
+            av_log(ffe_class, AV_LOG_WARNING,
+                   "H.264 macroblock with more than %d coefficients, signs beyond that untouched\n",
+                   FFE_H264_MAX_SIGNS);
+        fsl->sign_overflow = 1;
+        return;
+    }
+
+    for ( int i = 0; i < total_coeff; i++ )
+    {
+        int idx = fsl->nb_signs + i;
+        int sign = level[i] < 0;
+
+        if ( importing )
+        {
+            int want = sign_import_get(fsl, f, idx, sign);
+
+            if ( want != sign )
+            {
+                level[i] = -level[i];
+                if ( h->ffe.out_active )
+                {
+                    FFEditH264Edit *e;
+
+                    if ( i < trailing_ones )
+                    {
+                        /* trailing_ones_sign_flag: 1 = negative */
+                        e = record_edit(fsl, pos[0] + i, 1, FFE_H264_EDIT_BITS, want);
+                        if ( e != NULL )
+                            e->nbits = 1;
+                    }
+                    else
+                    {
+                        e = record_edit(fsl, pos[i], pos[i + 1] - pos[i],
+                                        FFE_H264_EDIT_LEVEL, level[i]);
+                        if ( e != NULL )
+                        {
+                            e->suffix_length = suffix_length[i];
+                            e->first = (i == trailing_ones && trailing_ones < 3);
+                        }
+                    }
+                }
+                sign = want;
+            }
+        }
+
+        fsl->signs[idx] = sign;
+    }
+    fsl->nb_signs += total_coeff;
+}
+
