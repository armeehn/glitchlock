+#include <stdlib.h>
+#include <string.h>
+
+#include "libavutil/mem.h"
+
+#include "cabac_functions.h"
+#include "ffedit.h"
+#include "ffedit_hevc.h"
+#include "ffedit_json.h"
+#include "ffedit_mv.h"
+#include "get_bits.h"
+#include "hevcdec.h"
+#include "put_bits.h"
+
+/* JSON directions: 0 = list0 ("forward"), 1 = list1 ("backward") */
+#define NB_DIRECTIONS 2
+/* smallest inter PU is 8x4 / 4x8: two per 8x8 CU */
+#define MIN_INTER_CU_LOG2 3
+#define PUS_PER_MIN_CU 2
+
+/* mvd is coded as se(v)-like EG1: the decoder stores it in int16 */
+#define MVD_MIN (-32768)
+#define MVD_MAX ( 32767)
+#define WRAP16(v) ((int) (int16_t) (v))
+
+/* bins of one mvd group: 2 greater0 + 2 greater1 + 2 x (prefix 15 +
+ * stop + suffix 15 + sign) is 68 */
+#define MAX_MVD_BINS 80
+/* abs_mvd_minus2 is EG1: first suffix length */
+#define MVD_EG_K 1
+
+/* CABAC encoder registers (H.265 9.3.4.3) */
+#define CABAC_RANGE_INIT 0x1FE
+#define CABAC_RANGE_MIN  0x100
+/* a context bin renormalises at most 7 times, a bypass bin writes
+ * one bit: 8 bits per bin bounds the output */
+#define MAX_BITS_PER_BIN 8
+
+/* emulation prevention: 00 00 0x with x <= 3 needs a 03 in between */
+#define EPB_MAX_FOLLOWING 3
+
+#define FEAT_MASK_MV ((1 << FFEDIT_FEAT_MV) | (1 << FFEDIT_FEAT_MV_DELTA))
+#define FEAT_MASK_OUTPUT (1 << FFEDIT_FEAT_LAST)
+
+/*-------------------------------------------------------------------*/
+int ffe_hevc_wants_mv(const AVCodecContext *avctx)
+{
+    uint64_t all = avctx->ffedit_export
+                 | avctx->ffedit_import
+                 | avctx->ffedit_apply;
+    return (all & FEAT_MASK_MV) != 0;
+}
+
+/*-------------------------------------------------------------------*/
+/* growable output packet                                            */
+/*-------------------------------------------------------------------*/
+static int out_append(FFEditHEVCContext *fe, const uint8_t *data, size_t size)
+{
+    void *tmp;
+
+    if ( size == 0 )
+        return 0;
+
+    tmp = av_fast_realloc(fe->out, &fe->out_alloc, fe->out_size + size);
+    if ( tmp == NULL )
+    {
+        fe->out_failed = 1;
+        return AVERROR(ENOMEM);
+    }
+    fe->out = tmp;
+
+    memcpy(fe->out + fe->out_size, data, size);
+    fe->out_size += size;
+
+    return 0;
+}
+
+/* append an RBSP as a NAL payload, re-inserting emulation prevention */
+static int out_append_escaped(FFEditHEVCContext *fe, const uint8_t *rbsp, size_t size)
+{
+    /* at most one 0x03 per two input bytes */
+    uint8_t *esc = av_malloc(size + size / 2 + 1);
+    size_t n = 0;
+    int zeros = 0;
+    int ret;
+
+    if ( esc == NULL )
+        return AVERROR(ENOMEM);
+
+    for ( size_t i = 0; i < size; i++ )
+    {
+        uint8_t b = rbsp[i];
+
+        if ( zeros >= 2 && b <= EPB_MAX_FOLLOWING )
+        {
+            esc[n++] = 0x03;
+            zeros = 0;
+        }
+        esc[n++] = b;
+        zeros = (b == 0) ? zeros + 1 : 0;
+    }
+
+    ret = out_append(fe, esc, n);
+    av_free(esc);
+
+    return ret;
+}
+
+/*-------------------------------------------------------------------*/
+/* bin log                                                           */
+/*-------------------------------------------------------------------*/
+static int log_reserve(FFEditHEVCContext *fe, size_t nb)
+{
+    size_t need = nb * sizeof(FFEditHEVCBin);
+    void *tmp;
+
+    if ( need <= fe->bins_alloc )
+        return 0;
+
+    tmp = av_fast_realloc(fe->bins, &fe->bins_alloc, need);
+    if ( tmp == NULL )
+    {
+        fe->log_failed = 1;
+        return AVERROR(ENOMEM);
+    }
+    fe->bins = tmp;
+
+    return 0;
+}
+
+void ffe_hevc_log_bin(FFEditHEVCContext *fe, int kind, int ctx, int bin)
+{
+    FFEditHEVCBin *b;
+
+    if ( fe->log_failed || log_reserve(fe, fe->nb_bins + 1) < 0 )
+        return;
+
+    b = &fe->bins[fe->nb_bins++];
+    b->kind = kind;
+    b->bin = bin;
+    b->ctx = ctx;
+}
+
+/*-------------------------------------------------------------------*/
+/* CABAC encoder (H.265 9.3.4.3, same engine as H.264)               */
+/*-------------------------------------------------------------------*/
+typedef struct CabacEnc {
+    PutBitContext pb;
+    int low;
+    int range;
+    int outstanding;
+    int first_bit;  /* firstBitFlag: the very first output bit is dropped */
+} CabacEnc;
+
+static void enc_init(CabacEnc *c, uint8_t *buf, int size)
+{
+    init_put_bits(&c->pb, buf, size);
+    c->low = 0;
+    c->range = CABAC_RANGE_INIT;
+    c->outstanding = 0;
+    c->first_bit = 1;
+}
+
+static void enc_put_bit(CabacEnc *c, int b)
+{
+    if ( c->first_bit )
+        c->first_bit = 0;
+    else
+        put_bits(&c->pb, 1, b);
+
+    for ( ; c->outstanding > 0; c->outstanding-- )
+        put_bits(&c->pb, 1, 1 - b);
+}
+
+static void enc_renorm(CabacEnc *c)
+{
+    while ( c->range < CABAC_RANGE_MIN )
+    {
+        if ( c->low < 0x100 )
+        {
+            enc_put_bit(c, 0);
+        }
+        else if ( c->low < 0x200 )
+        {
+            c->outstanding++;
+            c->low -= 0x100;
+        }
+        else
+        {
+            enc_put_bit(c, 1);
+            c->low -= 0x200;
+        }
+        c->range <<= 1;
+        c->low <<= 1;
+    }
+}
+
+static void enc_bin(CabacEnc *c, uint8_t *state, int bin)
+{
+    int range_lps = ff_h264_lps_range[2 * (c->range & 0xC0) + *state];
+
+    if ( bin == (*state & 1) )
+    {
+        c->range -= range_lps;
+        *state = ff_h264_mlps_state[128 + *state];
+    }
+    else
+    {
+        c->low += c->range - range_lps;
+        c->range = range_lps;
+        *state = ff_h264_mlps_state[127 - *state];
+    }
+
+    enc_renorm(c);
+}
+
+static void enc_bypass(CabacEnc *c, int bin)
+{
+    c->low <<= 1;
+    if ( bin )
+        c->low += c->range;
+
+    if ( c->low < 0x200 )
+    {
+        enc_put_bit(c, 0);
+    }
+    else if ( c->low < 0x400 )
+    {
+        c->outstanding++;
+        c->low -= 0x200;
+    }
+    else
+    {
+        enc_put_bit(c, 1);
+        c->low -= 0x400;
+    }
+}
+
+/* the last two bits written on termination end in the
+ * rbsp_stop_one_bit; the caller only has to byte-align */
+static void enc_terminate(CabacEnc *c, int bin)
+{
+    c->range -= 2;
+
+    if ( !bin )
+    {
+        enc_renorm(c);
+        return;
+    }
+
+    c->low += c->range;
+    c->range = 2;
+    enc_renorm(c);
+    enc_put_bit(c, c->low >> 9);
+    put_bits(&c->pb, 2, ((c->low >> 7) & 3) | 1);
+}
+
+/*-------------------------------------------------------------------*/
+/* packet level                                                      */
+/*-------------------------------------------------------------------*/
+void ffe_hevc_packet_start(HEVCContext *s, const AVPacket *avpkt)
+{
+    FFEditHEVCContext *fe = &s->ffe;
+    AVCodecContext *avctx = s->avctx;
+
+    if ( avctx->ffedit_import != 0 )
+    {
+        memcpy(fe->ffedit_sd, avpkt->ffedit_sd, sizeof(fe->ffedit_sd));
+        fe->jctx = avpkt->jctx;
+    }
+
+    fe->out_active = (avctx->ffedit_apply & FEAT_MASK_OUTPUT) != 0;
+    fe->out_failed = 0;
+    fe->out_size = 0;
+    fe->in_buf = avpkt->data;
+    fe->in_size = avpkt->size;
+    fe->in_pos = 0;
+    fe->log_active = 0;
+}
+
+/* hand the rebuilt packet to ffedit (same bookkeeping as
+ * ffe_transplicate_bits_flush()) */
+static void xp_flush(AVCodecContext *avctx, const AVPacket *pkt, const uint8_t *data, size_t size)
+{
+    FFEditTransplicatePacket *packet;
+    size_t nb = avctx->nb_ffe_xp_packets + 1;
+
+    if ( av_reallocp_array(&avctx->ffe_xp_packets, nb, sizeof(FFEditTransplicatePacket)) < 0 )
+        return;
+    avctx->nb_ffe_xp_packets = nb;
+
+    packet = &avctx->ffe_xp_packets[nb - 1];
+    packet->i_pos = pkt->pos;
+    packet->i_size = pkt->size;
+    packet->o_size = size;
+    packet->data = av_malloc(size);
+    memcpy(packet->data, data, size);
+}
+
+void ffe_hevc_packet_end(HEVCContext *s, const AVPacket *avpkt)
+{
+    FFEditHEVCContext *fe = &s->ffe;
+
+    fe->log_active = 0;
+
+    if ( !fe->out_active )
+        return;
+    fe->out_active = 0;
+
+    /* whatever follows the last NAL we looked at is copied as is */
+    out_append(fe, fe->in_buf + fe->in_pos, fe->in_size - fe->in_pos);
+
+    if ( fe->out_failed )
+    {
+        av_log(ffe_class, AV_LOG_WARNING,
+               "HEVC packet at %" PRId64 " could not be rebuilt, copied unchanged\n",
+               avpkt->pos);
+        xp_flush(s->avctx, avpkt, avpkt->data, avpkt->size);
+        return;
+    }
+
+    xp_flush(s->avctx, avpkt, fe->out, fe->out_size);
+}
+
+/*-------------------------------------------------------------------*/
+/* NAL rebuild                                                       */
+/*-------------------------------------------------------------------*/
+/* re-encode the logged slice. returns the new RBSP (caller frees)
+ * or NULL. */
+static uint8_t *rebuild_rbsp(
+        FFEditHEVCContext *fe,
+        const H2645NAL *nal,
+        size_t *out_size)
+{
+    uint8_t state[FFE_HEVC_NB_CONTEXTS];
+    size_t alloc;
+    uint8_t *rbsp;
+    CabacEnc enc;
+    int rem;
+
+    if ( fe->nb_bins == 0 || fe->data_buf != nal->data || fe->data_offset <= 0 || fe->data_offset > nal->size )
+        return NULL;
+
+    /* a slice ends on end_of_slice_segment_flag = 1 and nothing else */
+    if ( fe->bins[fe->nb_bins - 1].kind != FFE_HEVC_BIN_TERM || !fe->bins[fe->nb_bins - 1].bin )
+        return NULL;
+
+    alloc = fe->data_offset + (fe->nb_bins * MAX_BITS_PER_BIN) / 8 + 16 + AV_INPUT_BUFFER_PADDING_SIZE;
+    rbsp = av_malloc(alloc);
+    if ( rbsp == NULL )
+        return NULL;
+
+    /* slice header (with its byte_alignment) is untouched */
+    memcpy(rbsp, nal->data, fe->data_offset);
+
+    memcpy(state, fe->init_state, sizeof(state));
+    enc_init(&enc, rbsp + fe->data_offset, alloc - fe->data_offset);
+
+    for ( size_t i = 0; i < fe->nb_bins; i++ )
+    {
+        const FFEditHEVCBin *b = &fe->bins[i];
+
+        switch ( b->kind )
+        {
+        case FFE_HEVC_BIN_CTX:
+            enc_bin(&enc, &state[b->ctx], b->bin);
+            break;
+        case FFE_HEVC_BIN_BYPASS:
+            enc_bypass(&enc, b->bin);
+            break;
+        case FFE_HEVC_BIN_TERM:
+            enc_terminate(&enc, b->bin);
+            break;
+        }
+    }
+
+    /* rbsp_slice_segment_trailing_bits(): the stop bit was written by
+     * the terminating bin, only the alignment is left */
+    rem = put_bits_count(&enc.pb) & 7;
+    if ( rem != 0 )
+        put_bits(&enc.pb, 8 - rem, 0);
+    flush_put_bits(&enc.pb);
+
+    *out_size = fe->data_offset + put_bytes_output(&enc.pb);
+
+    return rbsp;
+}
+
+static int is_vcl(const H2645NAL *nal)
+{
+    return nal->type <= HEVC_NAL_CRA_NUT;
+}
+
+void ffe_hevc_nal_done(HEVCContext *s, const H2645NAL *nal)
+{
+    FFEditHEVCContext *fe = &s->ffe;
+    int nb_edits = (is_vcl(nal) && fe->log_active && !fe->log_failed) ? fe->nb_edits : 0;
+    int failed = is_vcl(nal) && fe->log_active && fe->log_failed;
+    size_t off;
+
+    /* the log belongs to this NAL only */
+    fe->log_active = 0;
+    fe->nb_edits = 0;
+
+    if ( !fe->out_active || fe->out_failed )
+        return;
+
+    if ( failed )
+    {
+        fe->out_failed = 1;
+        return;
+    }
+
+    off = nal->raw_data - fe->in_buf;
+    if ( nal->raw_data < fe->in_buf || off < fe->in_pos || off + nal->raw_size > fe->in_size )
+    {
+        fe->out_failed = 1;
+        return;
+    }
+
+    /* start code and anything else between NALs */
+    out_append(fe, fe->in_buf + fe->in_pos, off - fe->in_pos);
+    fe->in_pos = off + nal->raw_size;
+
+    if ( nb_edits == 0 )
+    {
+        out_append(fe, nal->raw_data, nal->raw_size);
+        return;
+    }
+
+    {
+        size_t rbsp_size = 0;
+        uint8_t *rbsp = rebuild_rbsp(fe, nal, &rbsp_size);
+
+        if ( rbsp == NULL )
+        {
+            fe->out_failed = 1;
+            return;
+        }
+
+        out_append_escaped(fe, rbsp, rbsp_size);
+        av_free(rbsp);
+    }
+}
+
+/*-------------------------------------------------------------------*/
+/* slice level                                                       */
+/*-------------------------------------------------------------------*/
+static void refuse(const char *what, const char *hint)
+{
+    av_log(ffe_class, AV_LOG_FATAL, "This HEVC stream uses %s.\n", what);
+    av_log(ffe_class, AV_LOG_FATAL,
+           "FFedit only supports the mv/mv_delta features on HEVC without it.\n");
+    if ( hint != NULL )
+        av_log(ffe_class, AV_LOG_FATAL, "%s\n", hint);
+    exit(1);
+}
+
+void ffe_hevc_check_slice(const HEVCContext *s)
+{
+    const HEVCPPS *pps = s->ps.pps;
+    const HEVCSPS *sps = s->ps.sps;
+
+    if ( !ffe_hevc_wants_mv(s->avctx) )
+        return;
+
+    if ( s->is_nalff )
+    {
+        av_log(ffe_class, AV_LOG_FATAL,
+               "This HEVC stream is length-prefixed (hvcC, e.g. inside MP4/MKV).\n");
+        av_log(ffe_class, AV_LOG_FATAL,
+               "FFedit only supports the mv/mv_delta features on raw Annex B HEVC (.265/.hevc).\n");
+        exit(1);
+    }
+
+    if ( pps->entropy_coding_sync_enabled_flag )
+        refuse("wavefront parallel processing (entropy_coding_sync_enabled_flag=1)",
+               "Re-encode without WPP (e.g. x265 --no-wpp).");
+    if ( pps->tiles_enabled_flag )
+        refuse("tiles (tiles_enabled_flag=1)", "Re-encode without tiles.");
+    if ( s->sh.dependent_slice_segment_flag )
+        refuse("dependent slice segments", NULL);
+    if ( sps->pcm_enabled_flag )
+        refuse("PCM coding (pcm_enabled_flag=1)", NULL);
+    if ( sps->cabac_bypass_alignment_enabled_flag )
+        refuse("CABAC bypass alignment", NULL);
+
+    if ( s->threads_number != 1 || (s->avctx->active_thread_type & FF_THREAD_FRAME) )
+    {
+        av_log(ffe_class, AV_LOG_FATAL,
+               "FFedit HEVC support requires a single decoding thread (threads=1).\n");
+        exit(1);
+    }
+}
+
+/* the CABAC decoder was just initialised on the first CTB of a slice
+ * segment: remember where the data starts and the context states */
+void ffe_hevc_slice_data_start(HEVCLocalContext *lc)
+{
+    FFEditHEVCContext *fe = lc->ffe;
+    const HEVCContext *s = lc->parent;
+
+    if ( fe == NULL )
+        return;
+
+    fe->log_active = fe->out_active && ffe_hevc_wants_mv(s->avctx);
+    fe->log_failed = 0;
+    fe->nb_bins = 0;
+    fe->nb_edits = 0;
+    fe->data_offset = get_bits_count(&lc->gb) / 8;
+    fe->data_buf = lc->gb.buffer;
+    memcpy(fe->init_state, lc->cabac_state, sizeof(fe->init_state));
+}
+
+/*-------------------------------------------------------------------*/
+/* frame level                                                       */
+/*-------------------------------------------------------------------*/
+static int max_pus_per_ctb(const HEVCSPS *sps)
+{
+    int shift = 2 * (sps->log2_ctb_size - MIN_INTER_CU_LOG2);
+    return PUS_PER_MIN_CU << shift;
+}
+
+void ffe_hevc_frame_start(HEVCContext *s)
+{
+    AVCodecContext *avctx = s->avctx;
+    FFEditHEVCContext *fe = &s->ffe;
+    const HEVCSPS *sps = s->ps.sps;
+    AVFrame *f = s->ref->frame;
+    int max_nb_blocks = FFMIN(max_pus_per_ctb(sps), MAX_MV2DARRAY_NBLOCKS);
+    json_ctx_t *jctx;
+
+    if ( avctx->ffedit_export == 0 && avctx->ffedit_import == 0 )
+        return;
+
+    /* one jctx per exported frame; importing borrows the packet's */
+    if ( avctx->ffedit_export != 0 )
+    {
+        f->jctx = json_ctx_new(1);
+        jctx = f->jctx;
+    }
+    else
+    {
+        jctx = fe->jctx;
+    }
+
+    if ( avctx->ffedit_import != 0 )
+        memcpy(f->ffedit_sd, fe->ffedit_sd, sizeof(json_t *) * FFEDIT_FEAT_LAST);
+
+    if ( (avctx->ffedit_export & (1 << FFEDIT_FEAT_MV)) != 0 )
+        ffe_mv_export_init_dirs(FFEDIT_FEAT_MV, jctx, f, sps->ctb_height, sps->ctb_width, NB_DIRECTIONS, max_nb_blocks);
+    else if ( (avctx->ffedit_import & (1 << FFEDIT_FEAT_MV)) != 0 && f->ffedit_sd[FFEDIT_FEAT_MV] != NULL )
+        ffe_mv_import_init(jctx, f);
+
+    if ( (avctx->ffedit_export & (1 << FFEDIT_FEAT_MV_DELTA)) != 0 )
+        ffe_mv_export_init_dirs(FFEDIT_FEAT_MV_DELTA, jctx, f, sps->ctb_height, sps->ctb_width, NB_DIRECTIONS, max_nb_blocks);
+    else if ( (avctx->ffedit_import & (1 << FFEDIT_FEAT_MV_DELTA)) != 0 && f->ffedit_sd[FFEDIT_FEAT_MV_DELTA] != NULL )
+        ffe_mv_delta_import_init(jctx, f);
+
+    fe->max_nb_blocks = max_nb_blocks;
+    fe->frame_active = 1;
+}
+
+void ffe_hevc_frame_end(HEVCContext *s)
+{
+    AVCodecContext *avctx = s->avctx;
+    FFEditHEVCContext *fe = &s->ffe;
+    AVFrame *f;
+
+    if ( !fe->frame_active || s->ref == NULL )
+        return;
+    fe->frame_active = 0;
+
+    f = s->ref->frame;
+    if ( (avctx->ffedit_export & (1 << FFEDIT_FEAT_MV)) != 0 )
+        ffe_mv_export_cleanup_dirs(FFEDIT_FEAT_MV, f->jctx, f);
+    if ( (avctx->ffedit_export & (1 << FFEDIT_FEAT_MV_DELTA)) != 0 )
+        ffe_mv_export_cleanup_dirs(FFEDIT_FEAT_MV_DELTA, f->jctx, f);
+}
+
+/*-------------------------------------------------------------------*/
+/* CTB / PU level                                                    */
+/*-------------------------------------------------------------------*/
+void ffe_hevc_ctb_start(HEVCLocalContext *lc, int x_ctb, int y_ctb)
+{
+    FFEditHEVCContext *fe = lc->ffe;
+    int log2_ctb = lc->parent->ps.sps->log2_ctb_size;
+
+    if ( fe == NULL )
+        return;
+
+    memset(&fe->mv, 0, sizeof(fe->mv));
+    memset(&fe->mv_delta, 0, sizeof(fe->mv_delta));
+    fe->mv.mb_x = fe->mv_delta.mb_x = x_ctb >> log2_ctb;
+    fe->mv.mb_y = fe->mv_delta.mb_y = y_ctb >> log2_ctb;
+    fe->blockn[0] = 0;
+    fe->blockn[1] = 0;
+}
+
+void ffe_hevc_mvd_start(HEVCLocalContext *lc, int g0_ctx, int g1_ctx)
+{
+    FFEditHEVCContext *fe = lc->ffe;
+
+    if ( fe == NULL )
+        return;
+    fe->mvd_start = fe->nb_bins;
+    fe->mvd_g0_ctx = g0_ctx;
+    fe->mvd_g1_ctx = g1_ctx;
+}
+
+void ffe_hevc_mvd_end(HEVCLocalContext *lc)
+{
+    FFEditHEVCContext *fe = lc->ffe;
+
+    if ( fe != NULL )
+        fe->mvd_end = fe->nb_bins;
+}
+
+/* read one component of a [x,y] pair, or fallback */
+static int pair_get(json_t *jmv, int x_or_y, int fallback)
+{
+    if ( jmv == NULL )
+        return fallback;
+
+    if ( JSON_TYPE(jmv->flags) == JSON_TYPE_ARRAY_OF_INTS && json_array_length(jmv) == 2 )
+        return jmv->array_of_ints[x_or_y];
+
+    if ( JSON_TYPE(jmv->flags) == JSON_TYPE_ARRAY && json_array_length(jmv) == 2 )
+    {
+        json_t *jval = json_array_get(jmv, x_or_y);
+        if ( jval != NULL && JSON_TYPE(jval->flags) == JSON_TYPE_NUMBER && !is_json_null(jval) )
+            return json_int_val(jval);
+    }
+
+    return fallback;
+}
+
+/* look up the imported value for this block; the JSON per CTB is
+ * null, [x,y] (one block) or [[x,y],...] (blocks in decode order). */
+static int import_get(
+        const ffe_mv_mb_ctx *mbctx,
+        AVFrame *f,
+        enum FFEditFeature feat,
+        int dir,
+        int blockn,
+        int x_or_y,
+        int fallback)
+{
+    json_t *jframe = f->ffedit_sd[feat];
+    ffe_mv_ctx *ctx;
+    json_t *jdata;
+    json_t *jrow;
+    json_t *jmb;
+
+    if ( jframe == NULL )
+        return fallback;
+    ctx = json_object_userdata_get(jframe);
+    if ( ctx == NULL )
+        return fallback;
+    jdata = ctx->data[dir];
+    if ( jdata == NULL )
+        return fallback;
+
+    /* scripting hands us the native 2d array back */
+    if ( ctx->import_is_mv2darray[dir] )
+    {
+        json_mv2darray_t *jmv2d = jdata->mv2darray;
+        size_t idx = mbctx->mb_y * jmv2d->width + mbctx->mb_x;
+        int32_t *mv;
+
+        if ( blockn >= jmv2d->max_nb_blocks || mbctx->mb_y >= jmv2d->height || mbctx->mb_x >= jmv2d->width )
+            return fallback;
+        mv = &jmv2d->mvs[blockn][idx << 1];
+        if ( mv[0] == MV_NULL )
+            return fallback;
+        return mv[x_or_y];
+    }
+
+    if ( JSON_TYPE(jdata->flags) != JSON_TYPE_ARRAY || json_array_length(jdata) <= mbctx->mb_y )
+        return fallback;
+    jrow = json_array_get(jdata, mbctx->mb_y);
+    if ( jrow == NULL || JSON_TYPE(jrow->flags) != JSON_TYPE_ARRAY || json_array_length(jrow) <= mbctx->mb_x )
+        return fallback;
+    jmb = json_array_get(jrow, mbctx->mb_x);
+    if ( jmb == NULL )
+        return fallback;
+
+    if ( JSON_TYPE(jmb->flags) == JSON_TYPE_ARRAY )
+    {
+        if ( json_array_length(jmb) <= blockn )
+            return fallback;
+        jmb = json_array_get(jmb, blockn);
+    }
+    else if ( blockn != 0 )
+    {
+        return fallback;
+    }
+
+    return pair_get(jmb, x_or_y, fallback);
+}
+
+/* binarisation of one mvd component after the greater0/greater1
+ * flags: abs_mvd_minus2 as EG1 bypass bins, then mvd_sign_flag */
+static int mvd_suffix_bins(FFEditHEVCBin *dst, int v)
+{
+    int n = 0;
+    int a = FFABS(v);
+
+    if ( a > 1 )
+    {
+        int rem = a - 2;
+        int k = MVD_EG_K;
+
+        while ( rem >= (1 << k) )
+        {
+            dst[n].kind = FFE_HEVC_BIN_BYPASS; dst[n].ctx = 0; dst[n++].bin = 1;
+            rem -= 1 << k;
+            k++;
+        }
+        dst[n].kind = FFE_HEVC_BIN_BYPASS; dst[n].ctx = 0; dst[n++].bin = 0;
+        while ( k-- > 0 )
+        {
+            dst[n].kind = FFE_HEVC_BIN_BYPASS; dst[n].ctx = 0; dst[n++].bin = (rem >> k) & 1;
+        }
+    }
+    if ( a > 0 )
+    {
+        dst[n].kind = FFE_HEVC_BIN_BYPASS; dst[n].ctx = 0; dst[n++].bin = v < 0;
+    }
+
+    return n;
+}
+
+/* mirror of ff_hevc_hls_mvd_coding() */
+static int mvd_bins(FFEditHEVCBin *dst, int g0_ctx, int g1_ctx, int x, int y)
+{
+    int ax = FFABS(x);
+    int ay = FFABS(y);
+    int n = 0;
+
+    dst[n].kind = FFE_HEVC_BIN_CTX; dst[n].ctx = g0_ctx; dst[n++].bin = ax > 0;
+    dst[n].kind = FFE_HEVC_BIN_CTX; dst[n].ctx = g0_ctx; dst[n++].bin = ay > 0;
+    if ( ax > 0 )
+    {
+        dst[n].kind = FFE_HEVC_BIN_CTX; dst[n].ctx = g1_ctx; dst[n++].bin = ax > 1;
+    }
+    if ( ay > 0 )
+    {
+        dst[n].kind = FFE_HEVC_BIN_CTX; dst[n].ctx = g1_ctx; dst[n++].bin = ay > 1;
+    }
+    n += mvd_suffix_bins(dst + n, x);
+    n += mvd_suffix_bins(dst + n, y);
+
+    return n;
+}
+
+/* replace the logged mvd group with the bins of (x, y) */
+static void splice_mvd(FFEditHEVCContext *fe, int x, int y)
+{
+    FFEditHEVCBin grp[MAX_MVD_BINS];
+    size_t old_n = fe->mvd_end - fe->mvd_start;
+    size_t tail = fe->nb_bins - fe->mvd_end;
+    int n;
+
+    if ( fe->log_failed || fe->mvd_end < fe->mvd_start || fe->mvd_end > fe->nb_bins || old_n < 2 )
+    {
+        fe->log_failed = 1;
+        return;
+    }
+
+    n = mvd_bins(grp, fe->mvd_g0_ctx, fe->mvd_g1_ctx, x, y);
+
+    if ( log_reserve(fe, fe->nb_bins - old_n + n) < 0 )
+        return;
+
+    memmove(fe->bins + fe->mvd_start + n, fe->bins + fe->mvd_end, tail * sizeof(FFEditHEVCBin));
+    memcpy(fe->bins + fe->mvd_start, grp, n * sizeof(FFEditHEVCBin));
+    fe->nb_bins += n - old_n;
+    fe->mvd_end = fe->mvd_start + n;
+    fe->nb_edits++;
+}
+
+static void warn_wrapped(int mv)
+{
+    static int warned = 0;
+
+    if ( warned )
+        return;
+    warned = 1;
+    av_log(ffe_class, AV_LOG_WARNING,
+           "HEVC mv %d outside [%d, %d], wrapped (further warnings suppressed)\n",
+           mv, MVD_MIN, MVD_MAX);
+}
+
+void ffe_hevc_mvd(HEVCLocalContext *lc, int list, int pred_x, int pred_y, Mv *mvd)
+{
+    FFEditHEVCContext *fe = lc->ffe;
+    const HEVCContext *s = lc->parent;
+    const AVCodecContext *avctx = s->avctx;
+    AVFrame *f = s->ref->frame;
+    int blockn;
+    int orig_x = mvd->x;
+    int orig_y = mvd->y;
+    int x = orig_x;
+    int y = orig_y;
+
+    if ( fe == NULL )
+        return;
+    blockn = fe->blockn[list]++;
+
+    if ( (avctx->ffedit_import & (1 << FFEDIT_FEAT_MV_DELTA)) != 0 )
+    {
+        x = WRAP16(import_get(&fe->mv_delta, f, FFEDIT_FEAT_MV_DELTA, list, blockn, 0, x));
+        y = WRAP16(import_get(&fe->mv_delta, f, FFEDIT_FEAT_MV_DELTA, list, blockn, 1, y));
+    }
+
+    /* "mv" is the final vector; the stream carries the difference.
+     * the decoder adds in int16, so any target wraps exactly. */
+    if ( (avctx->ffedit_import & (1 << FFEDIT_FEAT_MV)) != 0 )
+    {
+        int tx = import_get(&fe->mv, f, FFEDIT_FEAT_MV, list, blockn, 0, WRAP16(pred_x + x));
+        int ty = import_get(&fe->mv, f, FFEDIT_FEAT_MV, list, blockn, 1, WRAP16(pred_y + y));
+
+        if ( tx < MVD_MIN || tx > MVD_MAX )
+            warn_wrapped(tx);
+        if ( ty < MVD_MIN || ty > MVD_MAX )
+            warn_wrapped(ty);
+        x = WRAP16(tx - pred_x);
+        y = WRAP16(ty - pred_y);
+    }
+
+    if ( fe->log_active && (x != orig_x || y != orig_y) )
+        splice_mvd(fe, x, y);
+
+    mvd->x = x;
+    mvd->y = y;
+
+    if ( blockn >= fe->max_nb_blocks )
+        return;
+
+    if ( (avctx->ffedit_export & (1 << FFEDIT_FEAT_MV)) != 0 )
+    {
+        ffe_mv_export_select(&fe->mv, f, list, blockn);
+        ffe_mv_set(&fe->mv, 0, WRAP16(pred_x + x));
+        ffe_mv_set(&fe->mv, 1, WRAP16(pred_y + y));
+    }
+
+    if ( (avctx->ffedit_export & (1 << FFEDIT_FEAT_MV_DELTA)) != 0 )
+    {
+        ffe_mv_delta_export_select(&fe->mv_delta, f, list, blockn);
+        ffe_mv_delta_set(&fe->mv_delta, 0, x);
+        ffe_mv_delta_set(&fe->mv_delta, 1, y);
+    }
+}
+
+/*-------------------------------------------------------------------*/
+void ffe_hevc_uninit(HEVCContext *s)
+{
+    FFEditHEVCContext *fe = &s->ffe;
+
+    av_freep(&fe->bins);
+    fe->bins_alloc = 0;
+    fe->nb_bins = 0;
+    av_freep(&fe->out);
+    fe->out_alloc = 0;
+    fe->out_size = 0;
+}
