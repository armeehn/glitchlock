+ */
+
+#ifndef AVCODEC_FFEDIT_HEVC_H
+#define AVCODEC_FFEDIT_HEVC_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "avcodec.h"
+#include "packet.h"
+#include "ffedit_mv.h"
+#include "h2645_parse.h"
+
+struct HEVCContext;
+struct HEVCLocalContext;
+struct Mv;
+
+/*
+ * FFedit for HEVC.
+ *
+ * HEVC slice data is CABAC only, so no syntax element can be rewritten
+ * in place: the arithmetic coder state after an edited mvd differs
+ * from the original and every following bit changes.  Instead the
+ * whole slice is re-encoded from its bins:
+ *
+ *   decoder:  bin bin bin [mvd bins] bin bin ... [end_of_slice]
+ *                |   |   |    |
+ *                v   v   v    v            (every bin is logged with
+ *   log:      (ctx,b)(ctx,b)(bypass,b)...   its context or bypass/term)
+ *
+ *   apply:    replace the logged mvd group, re-run the CABAC encoder
+ *             over the log from the slice's initial context states,
+ *             append rbsp_slice_segment_trailing_bits, re-insert
+ *             emulation prevention bytes.
+ *
+ * Context selection never depends on an mvd value and the mvd bins
+ * form one contiguous group, so splicing a group leaves every other
+ * bin and its context untouched.  NALs without edits are copied raw.
+ *
+ * Refused with a clear message when an mv feature is requested: WPP,
+ * tiles, dependent slice segments, PCM, CABAC bypass alignment,
+ * length-prefixed (hvcC) input, more than one decoding thread.
+ */
+
+/* one logged bin */
+enum FFEditHEVCBinKind {
+    FFE_HEVC_BIN_CTX = 0,
+    FFE_HEVC_BIN_BYPASS,
+    FFE_HEVC_BIN_TERM,
+};
+
+typedef struct FFEditHEVCBin {
+    uint8_t  kind;
+    uint8_t  bin;
+    uint16_t ctx;
+} FFEditHEVCBin;
+
+/* sized for HEVC_CONTEXTS without pulling in hevcdec.h */
+#define FFE_HEVC_NB_CONTEXTS 199
+
+typedef struct FFEditHEVCContext {
+    /* import: JSON side data handed over by the packet */
+    void *jctx;
+    void *ffedit_sd[32]; // should be at least [FFEDIT_FEAT_LAST]
+
+    /* export: set between frame start and frame end */
+    int frame_active;
+    ffe_mv_mb_ctx mv;
+    ffe_mv_mb_ctx mv_delta;
+    int blockn[2];
+
+    /* apply: the packet being rebuilt */
+    const uint8_t *in_buf;
+    size_t in_size;
+    size_t in_pos;      /* input bytes consumed so far */
+    uint8_t *out;
+    size_t out_size;
+    unsigned out_alloc;
+    int out_active;
+    int out_failed;
+
+    /* apply: the slice being logged */
+    int log_active;
+    int log_failed;
+    FFEditHEVCBin *bins;
+    size_t nb_bins;
+    unsigned bins_alloc;
+    uint8_t init_state[FFE_HEVC_NB_CONTEXTS];
+    int data_offset;    /* first slice data byte, from the NAL start */
+    int nb_edits;
+    size_t mvd_start;   /* log range of the mvd group just decoded */
+    size_t mvd_end;
+    int mvd_g0_ctx;     /* contexts of abs_mvd_greater0/1_flag */
+    int mvd_g1_ctx;
+    const uint8_t *data_buf; /* the RBSP the offsets refer to */
+    int max_nb_blocks;  /* PUs per CTB the export arrays hold */
+} FFEditHEVCContext;
+
+int  ffe_hevc_wants_mv(const AVCodecContext *avctx);
+
+void ffe_hevc_packet_start(struct HEVCContext *s, const AVPacket *avpkt);
+void ffe_hevc_packet_end(struct HEVCContext *s, const AVPacket *avpkt);
+void ffe_hevc_nal_done(struct HEVCContext *s, const H2645NAL *nal);
+
+void ffe_hevc_check_slice(const struct HEVCContext *s);
+void ffe_hevc_slice_data_start(struct HEVCLocalContext *lc);
+
+void ffe_hevc_frame_start(struct HEVCContext *s);
+void ffe_hevc_frame_end(struct HEVCContext *s);
+
+void ffe_hevc_ctb_start(struct HEVCLocalContext *lc, int x_ctb, int y_ctb);
+void ffe_hevc_mvd_start(struct HEVCLocalContext *lc, int g0_ctx, int g1_ctx);
+void ffe_hevc_mvd_end(struct HEVCLocalContext *lc);
+void ffe_hevc_mvd(struct HEVCLocalContext *lc,
+                  int list,
+                  int pred_x,
+                  int pred_y,
+                  struct Mv *mvd);
+
+void ffe_hevc_uninit(struct HEVCContext *s);
+
+/* bin logging, wrapped around every CABAC read in hevc_cabac.c */
+void ffe_hevc_log_bin(FFEditHEVCContext *fe, int kind, int ctx, int bin);
+
+static inline int ffe_hevc_bin(FFEditHEVCContext *fe, int ctx, int bin)
+{
+    if ( fe != NULL && fe->log_active )
+        ffe_hevc_log_bin(fe, FFE_HEVC_BIN_CTX, ctx, bin);
+    return bin;
+}
+
+static inline int ffe_hevc_bypass(FFEditHEVCContext *fe, int bin)
+{
+    if ( fe != NULL && fe->log_active )
+        ffe_hevc_log_bin(fe, FFE_HEVC_BIN_BYPASS, 0, bin);
+    return bin;
+}
+
+/* get_cabac_bypass_sign(c, val) returns -val for bin 0 and val for
+ * bin 1; every caller passes a negative val, so bin = (ret < 0) */
+static inline int ffe_hevc_bypass_sign(FFEditHEVCContext *fe, int ret)
+{
+    if ( fe != NULL && fe->log_active )
+        ffe_hevc_log_bin(fe, FFE_HEVC_BIN_BYPASS, 0, ret < 0);
+    return ret;
+}
+
+static inline int ffe_hevc_term(FFEditHEVCContext *fe, int ret)
+{
+    if ( fe != NULL && fe->log_active )
+        ffe_hevc_log_bin(fe, FFE_HEVC_BIN_TERM, 0, ret != 0);
+    return ret;
+}
+
+#endif /* AVCODEC_FFEDIT_HEVC_H */
