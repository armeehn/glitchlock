From 04272b90284fbd79c5a763ecfca887411e6de6c6 Mon Sep 17 00:00:00 2001
From: Sasha Zero <sasha@ripostelabs.xyz>
Date: Sat, 12 Sep 2026 08:44:36 -0700
Subject: [PATCH 1/3] Add direction-only mv export helpers

H.264 has no fcode/bcode and no direct vectors, so the existing
mv_export_init() would leave misleading keys in the exported JSON.
Add ffe_mv_export_init_dirs()/ffe_mv_export_cleanup_dirs(), which
build the same per-macroblock 2D array but only with the "forward"
and "backward" keys.

An H.264 macroblock can carry up to 16 vectors per list (four 8x8
partitions with four 4x4 sub-partitions each), so raise
MAX_MV2DARRAY_NBLOCKS from 4 to 16. Allocation is driven by the
caller's max_nb_blocks, so existing codecs are unaffected.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 libavcodec/ffedit_mv.c | 57 ++++++++++++++++++++++++++++++++++++++++++
 libavcodec/ffedit_mv.h | 14 +++++++++++
 libavutil/json.h       |  2 +-
 3 files changed, 72 insertions(+), 1 deletion(-)

diff --git a/libavcodec/ffedit_mv.c b/libavcodec/ffedit_mv.c
index f3fbd38..ec42617 100644
--- a/libavcodec/ffedit_mv.c
+++ b/libavcodec/ffedit_mv.c
@@ -597,3 +597,60 @@ void ffe_mv_delta_import_init(json_ctx_t *jctx, AVFrame *f)
 {
     mv_import_init(FFEDIT_FEAT_MV_DELTA, jctx, f);
 }
+
+/*-------------------------------------------------------------------*/
+/* direction-only variant (H.264): no fcode/bcode/direct/overflow    */
+/*-------------------------------------------------------------------*/
+void ffe_mv_export_init_dirs(
+        enum FFEditFeature feat,
+        json_ctx_t *jctx,
+        AVFrame *f,
+        int mb_height,
+        int mb_width,
+        int nb_directions,
+        int max_nb_blocks)
+{
+    // {
+    //  "forward":  [ ] # line
+    //              [ ] # column
+    //              null or [ mv_x, mv_y ]
+    //                   or [ [ mv_x, mv_y ], ... ]
+    //  "backward": (same, only if nb_directions > 1)
+    // }
+
+    static const char *const keys[3] = { "forward", "backward", "direct" };
+    json_t *jframe = json_object_new(jctx);
+    ffe_mv_ctx *ctx = json_allocator_get0(jctx, sizeof(ffe_mv_ctx));
+    json_object_userdata_set(jframe, ctx);
+
+    ctx->overflow_action = MV_OVERFLOW_IGNORE;
+    for ( int i = 0; i < nb_directions; i++ )
+    {
+        ctx->data[i] = json_mv2darray_new(jctx, mb_width, mb_height, max_nb_blocks, -1);
+        ctx->used[i] = 0;
+        json_object_add(jframe, keys[i], ctx->data[i]);
+    }
+
+    f->ffedit_sd[feat] = jframe;
+}
+
+void ffe_mv_export_cleanup_dirs(
+        enum FFEditFeature feat,
+        json_ctx_t *jctx,
+        AVFrame *f)
+{
+    static const char *const keys[3] = { "forward", "backward", "direct" };
+    json_t *jframe = f->ffedit_sd[feat];
+    ffe_mv_ctx *ctx = json_object_userdata_get(jframe);
+
+    for ( int i = 0; i < 3; i++ )
+    {
+        if ( ctx->data[i] == NULL )
+            continue;
+        if ( ctx->used[i] == 0 )
+            json_object_del(jframe, keys[i]);
+        else
+            json_mv2darray_done(jctx, ctx->data[i]);
+    }
+    json_object_done(jctx, jframe);
+}
diff --git a/libavcodec/ffedit_mv.h b/libavcodec/ffedit_mv.h
index 17ac4d7..f368eda 100644
--- a/libavcodec/ffedit_mv.h
+++ b/libavcodec/ffedit_mv.h
@@ -24,6 +24,7 @@
 #include "libavutil/json.h"
 
 #include "avcodec.h"
+#include "ffedit.h"
 
 // #define WIP_MV_2DARRAY
 
@@ -169,4 +170,17 @@ int ffe_mv_delta_overflow(
 void ffe_mv_delta_export_cleanup(json_ctx_t *jctx, AVFrame *f);
 void ffe_mv_delta_import_init(json_ctx_t *jctx, AVFrame *f);
 
+void ffe_mv_export_init_dirs(
+        enum FFEditFeature feat,
+        json_ctx_t *jctx,
+        AVFrame *f,
+        int mb_height,
+        int mb_width,
+        int nb_directions,
+        int max_nb_blocks);
+void ffe_mv_export_cleanup_dirs(
+        enum FFEditFeature feat,
+        json_ctx_t *jctx,
+        AVFrame *f);
+
 #endif /* AVCODEC_FFEDIT_MV_H */
diff --git a/libavutil/json.h b/libavutil/json.h
index ab40f25..2d46fc0 100644
--- a/libavutil/json.h
+++ b/libavutil/json.h
@@ -47,7 +47,7 @@ typedef struct {
     void *userdata;
 } json_arr_t;
 
-#define MAX_MV2DARRAY_NBLOCKS 4
+#define MAX_MV2DARRAY_NBLOCKS 16
 #define MV_NULL 0x80000000
 typedef struct {
     int32_t *mvs[MAX_MV2DARRAY_NBLOCKS];
-- 
